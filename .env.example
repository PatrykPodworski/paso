# Optional: generate natural Spanish audio with ElevenLabs.
# Copy to .env.local. These variables are read only by the Node generator.
# Never prefix the API key with VITE_; it must not reach the browser.
# Required: Text to Speech and User: Read (to check remaining free credits).
# Voices: Read is optional for audio:voices.
# History: Read is optional for audio:recover (download completed recordings).
ELEVENLABS_API_KEY=
# Sarah: premade voice, verified working for Spanish on this free account.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# OpenRouter key for api/review-writing.ts (vercel dev) and pnpm eval:writing; never prefix it with VITE_.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Required OpenRouter model id for writing reviews (no default), for example anthropic/claude-sonnet-5.5.
OPENROUTER_MODEL=provider/model-id
