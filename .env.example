# Optional: generate natural Spanish audio with ElevenLabs.
# Copy to .env.local. These variables are read only by the Node generator.
# Never prefix the API key with VITE_; it must not reach the browser.
# Required: Text to Speech and User: Read (to check remaining free credits).
# Voices: Read is optional for audio:voices.
# History: Read is optional for audio:recover (download completed recordings).
ELEVENLABS_API_KEY=
