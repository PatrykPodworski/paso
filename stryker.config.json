{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/data/progress.ts",
    "src/data/audio.ts",
    "src/data/audio-sources.ts",
    "src/data/coach.ts",
    "src/hooks/useCoach.ts",
    "src/components/{Audio,Recorder,QuestionCard,LessonSession,MockExam,Dialog,Guide,CoachFeedback}.tsx",
    "src/App.tsx",
    "server/coach.ts",
    "scripts/audio-budget.mjs",
    "scripts/elevenlabs.mjs",
    "scripts/generate-elevenlabs.mjs"
  ],
  "ignorePatterns": [
    ".venv-coach",
    "docs/screenshots",
    "dist",
    "coverage",
    "test-results",
    "playwright-report",
    "reports",
    ".env.local",
    ".elevenlabs-usage.local.json",
    ".cache"
  ],
  "concurrency": 8,
  "timeoutMS": 2000,
  "reporters": ["clear-text", "progress", "html", "json"],
  "incremental": true,
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 0
  },
  "tempDirName": ".stryker-tmp",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "tsconfigFile": "tsconfig.stryker-unused.json"
}
